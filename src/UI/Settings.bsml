<settings-container>
  <checkbox-setting text='Auto-Setup' value='autosetup' hover-hint='Attempt to find visemes on a model not built specifically for lipsyncing. Not foolproof.' />
  <dropdown-list-setting text='Mic Input' value='micinput' choices='micoptions' hover-hint='Select the mic to use for lipsync.' />
  <slider-setting text='Viseme Scale' value='visemescale' min='0.1' max='5.0' step='0.1' hover-hint='Scale the viseme values to make them more or less pronounced.' />  
</settings-container>